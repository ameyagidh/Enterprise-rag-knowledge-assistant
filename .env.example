# Copy this file to .env and fill in the values you need.
# Only the API key for whichever LLM_PROVIDER you choose is required.

# --- LLM provider selection: openai | anthropic | ollama ---
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Used if LLM_PROVIDER=ollama (no API key needed; run `ollama serve` locally
# or point this at a remote Ollama instance)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Pipeline tuning (optional, sane defaults apply) ---
DOCS_DIR=./knowledge_base
PERSIST_DIR=./chroma_store
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVE_K=10
RERANK_TOP_N=4

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Leave blank to run the API with no auth (fine for local dev only).
API_AUTH_TOKEN=

# --- UI ---
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
